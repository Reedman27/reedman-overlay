pkgname=reedmuhn-wmaker
pkgver=1.0.4
pkgrel=1
pkgdesc="ReedMuhn Window Maker environment"
arch=('any')
license=('MIT')
depends=('windowmaker' 'wm-desktop' 'picom' 'sxhkd' 'xorg-server' 'xorg-xinit')

package() {
	install -dm755 "$pkgdir/usr/share/doc/$pkgname"
	echo "$pkgname $pkgver" > "$pkgdir/usr/share/doc/$pkgname/VERSION"
}
