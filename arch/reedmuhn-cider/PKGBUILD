pkgname=reedmuhn-cider
pkgver=1.0.4
pkgrel=1
pkgdesc="ReedMuhn Cider: Apple Music client"
arch=('any')
license=('MIT')
depends=('reedmuhn-cider-repo' 'cider')

package() {
	install -dm755 "$pkgdir/usr/share/doc/$pkgname"
	echo "$pkgname $pkgver" > "$pkgdir/usr/share/doc/$pkgname/VERSION"
}
