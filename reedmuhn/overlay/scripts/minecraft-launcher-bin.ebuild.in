# Generated by scripts/bump-minecraft.sh
# Distributed under the terms of the GNU General Public License v2

EAPI=8

inherit unpacker xdg

DESCRIPTION="Official Minecraft Launcher (repackaged from Mojang's .deb)"
HOMEPAGE="https://www.minecraft.net"
SRC_URI="@URI@ -> ${P}.deb"
S="${WORKDIR}"

LICENSE="Mojang-EULA"
SLOT="0"
KEYWORDS="-* ~amd64"
RESTRICT="bindist mirror strip"

RDEPEND="
    app-crypt/libsecret
    dev-libs/libbsd
    dev-libs/nss
    media-libs/alsa-lib
    media-libs/openal
    net-misc/curl
    net-print/cups
    sys-apps/dbus
    virtual/opengl
    x11-apps/xrandr
    x11-libs/gtk+:3
    x11-libs/libXScrnSaver
    x11-libs/libXcomposite
    x11-libs/libXcursor
    x11-libs/libXdamage
    x11-libs/libXext
    x11-libs/libXfixes
    x11-libs/libXi
    x11-libs/libXrender
    x11-libs/libXtst
    x11-libs/xcb-util
"
BDEPEND="$(unpacker_src_uri_depends)"

QA_PREBUILT="usr/bin/minecraft-launcher"

src_unpack() {
    unpacker_src_unpack
}

src_install() {
    dobin usr/bin/minecraft-launcher

    insinto /usr/share
    doins -r usr/share/applications usr/share/icons
}
