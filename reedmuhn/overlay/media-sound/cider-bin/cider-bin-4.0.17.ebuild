EAPI=8

inherit unpacker xdg


DESCRIPTION="Cider - Apple Music client by Cider Collective (prebuilt binary)"
HOMEPAGE="https://cider.sh"
SRC_URI="https://repo.cider.sh/apt/pool/main/cider-v4.0.17-linux-x64.deb -> ${P}.deb"
S="${WORKDIR}"

# Proprietary, and a paid licence is needed to actually use it.
LICENSE="all-rights-reserved"
SLOT="0"
KEYWORDS="-* ~amd64"
RESTRICT="bindist mirror strip"

# Electron/Chromium runtime deps, mapped from the .deb's Depends/Recommends
RDEPEND="
	app-accessibility/at-spi2-core:2
	dev-libs/glib:2
	dev-libs/nss
	media-libs/alsa-lib
	media-libs/mesa[gbm(+)]
	sys-apps/dbus
	x11-libs/cairo
	x11-libs/gtk+:3
	x11-libs/libdrm
	x11-libs/libnotify
	x11-libs/libxcb
	x11-libs/libXcomposite
	x11-libs/libXdamage
	x11-libs/libXfixes
	x11-libs/libXrandr
	x11-libs/libXScrnSaver
	x11-libs/libXtst
	x11-libs/libxkbcommon
	x11-libs/pango
	x11-misc/xdg-utils
"
BDEPEND="$(unpacker_src_uri_depends)"

QA_PREBUILT="opt/cider/*"

src_unpack() {
	unpacker_src_unpack
}

src_install() {
	# The deb ships everything in /usr/lib/cider; Gentoo keeps binaries in /opt.
	insinto /opt/cider
	doins -r usr/lib/cider/.
	fperms +x /opt/cider/Cider /opt/cider/chrome_crashpad_handler
	fperms +x /opt/cider/libffmpeg.so /opt/cider/libvk_swiftshader.so /opt/cider/libvulkan.so.1
	# suid sandbox helper, same as upstream's package
	fperms 4711 /opt/cider/chrome-sandbox

	dosym ../../opt/cider/Cider /usr/bin/cider

	insinto /usr/share/applications
	doins usr/share/applications/cider.desktop
	insinto /usr/share/pixmaps
	doins usr/share/pixmaps/cider.png
}
