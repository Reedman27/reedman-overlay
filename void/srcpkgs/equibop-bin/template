# Template file for 'equibop-bin'
pkgname=equibop-bin
version=3.3.4
revision=1
archs="x86_64"
short_desc="Custom Discord client with Equicord preinstalled"
maintainer="Reedman27 <packages@reedmuhn.invalid>"
license="GPL-3.0-only"
homepage="https://github.com/Equicord/Equibop"
distfiles="https://github.com/Equicord/Equibop/releases/download/v${version}/equibop_${version}_amd64.deb"
checksum="SKIP" # Replace with verified upstream SHA-256 before publishing.
hostmakedepends="binutils tar xz"
depends="alsa-lib at-spi2-core glib nss dbus-libs cairo cups-libs expat libdrm libXext libXss libxshmfence libsecret gtk+3 pango libX11 libxcb libXcomposite libXdamage libXfixes libXrandr libXScrnSaver libXtst libxkbcommon mesa xdg-utils"

do_install() {
    ar x "${XBPS_SRCDISTDIR}/${pkgname}-${version}/equibop_${version}_amd64.deb" --output="${wrksrc}"
    local data_archive
    data_archive=$(find "${wrksrc}" -maxdepth 1 -name 'data.tar.*' -print -quit)
    mkdir -p "${DESTDIR}"
    tar -xf "${data_archive}" -C "${DESTDIR}"
}
